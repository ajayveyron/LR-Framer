# ─── Required: Authentication (Clerk) ───
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret
CLERK_WEBHOOK_SECRET=whsec_your_clerk_webhook_secret

# ─── Required: Database (Convex) ───
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_DEPLOY_KEY=prod:your_deploy_key

# ─── Required: Encryption ───
PRODUCT_ENCRYPTION_KEY=replace-with-a-long-random-string

# ─── Required: App URL ───
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Optional: Legacy bridge Framer key ───
FRAMER_API_KEY=ap_your_server_api_key

# ─── Optional: AI / Vertex AI ───
# Dashboard works without these — AI features degrade gracefully.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
GOOGLE_PRIVATE_KEY_ID=your_private_key_id

# ─── Optional: Notion bridge ───
NOTION_API_KEY=secret_xxx
NOTION_WEBHOOK_SECRET=choose-a-long-random-secret

# ─── Optional: Billing (Dodo Payments) ───
# Billing degrades gracefully when not configured.
DODO_API_KEY=your_dodo_api_key
DODO_WEBHOOK_SECRET=your_dodo_webhook_secret
DODO_STANDARD_PRODUCT_ID=your_standard_product_id
DODO_BUSINESS_ID=your_business_id
DODO_TEST_MODE=true

# ─── Optional: Email (Resend) ───
# Emails degrade gracefully when not configured.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=hello@yourdomain.com
