{
  "brand": "LinkRunner.io",
  "aesthetic": "Modern Dark Mode / Tech SaaS",
  "designTokens": {
    "colors": {
      "brand": {
        "primary": "#4D4BF6",
        "accentGlows": ["rgba(77, 75, 246, 0.15)", "rgba(0, 0, 0, 0)"]
      },
      "background": {
        "base": "#000000",
        "surface": "#0C0E12",
        "surfaceElevated": "#080808"
      },
      "text": {
        "primary": "#F7F7F7",
        "secondary": "rgba(255, 255, 255, 0.6)",
        "muted": "#999999",
        "inverse": "#000000"
      },
      "border": {
        "default": "rgba(255, 255, 255, 0.1)"
      }
    },
    "typography": {
      "fontFamily": {
        "heading": "Geist, sans-serif",
        "body": "Inter, sans-serif"
      },
      "headings": {
        "h1": {
          "fontSize": "56px",
          "fontWeight": 700,
          "lineHeight": "1.1"
        },
        "h2": {
          "fontSize": "36px",
          "fontWeight": 700,
          "lineHeight": "1.2"
        },
        "h3": {
          "fontSize": "28px",
          "fontWeight": 700,
          "lineHeight": "1.4"
        }
      },
      "body": {
        "heroSubtext": {
          "fontSize": "24px",
          "fontWeight": 400,
          "lineHeight": "1.5"
        },
        "article": {
          "fontSize": "18px",
          "fontWeight": 400,
          "lineHeight": "1.4"
        },
        "standard": {
          "fontSize": "16px",
          "fontWeight": 400,
          "lineHeight": "1.5"
        }
      }
    },
    "uiElements": {
      "buttons": {
        "borderRadius": "10px",
        "padding": "12px 20px",
        "variants": {
          "primaryLight": {
            "backgroundColor": "#FFFFFF",
            "color": "#000000",
            "border": "none"
          },
          "brand": {
            "backgroundColor": "#4D4BF6",
            "color": "#FFFFFF",
            "border": "none"
          },
          "ghostOutlined": {
            "backgroundColor": "transparent",
            "color": "#F7F7F7",
            "border": "1px solid rgba(255, 255, 255, 0.1)"
          }
        }
      },
      "cards": {
        "borderRadius": "12px",
        "backgroundColor": "#0C0E12",
        "border": "1px solid rgba(255, 255, 255, 0.1)",
        "boxShadow": "none"
      },
      "inputs": {
        "backgroundColor": "#0C0E12",
        "border": "1px solid rgba(255, 255, 255, 0.1)",
        "color": "#F7F7F7",
        "placeholderColor": "#999999"
      }
    },
    "layout": {
      "maxWidth": "1200px",
      "spacing": {
        "sectionVertical": "80px",
        "sectionVerticalLarge": "120px",
        "containerPaddingHorizontal": "24px",
        "elementGap": "24px"
      }
    }
  }
}
